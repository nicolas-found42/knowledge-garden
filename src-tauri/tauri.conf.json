{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knowledge Garden",
  "version": "0.1.0",
  "identifier": "com.nicolasfound.knowledgegarden",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Knowledge Garden",
        "width": 1040,
        "height": 760,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "A durable local Markdown collection",
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
